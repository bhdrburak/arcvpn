<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notificationLayout"
    android:layout_width="match_parent"
    android:layout_height="115dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="6dp"
    android:padding="@dimen/layout_16_margin"
    android:theme = "@style/Theme.AppCompat"
    android:layout_marginStart="@dimen/margin_horizontal"
    android:layout_marginEnd="@dimen/margin_horizontal"
    android:background="@drawable/permission_item_bg">


    <TextView
        android:id="@+id/newText"
        android:layout_width="40dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textAlignment="center"
        android:visibility="gone"
        android:fontFamily="@font/montserrat_400"
        android:textSize="@dimen/text_size_12"
        android:text="@string/notifications"
        android:textColor="@color/active_color"
        android:background="@drawable/permission_item_bg"
        android:layout_marginEnd="@dimen/layout_6_margin"/>

    <TextView
        android:id="@+id/txtNotificationTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:fontFamily="@font/montserrat_400"
        android:textSize="@dimen/text_size_14"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>



    <TextView
        android:id="@+id/txtNotificationDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_12_margin"
        android:textColor="?attr/colorPrimary"
        android:fontFamily="@font/montserrat_400"
        android:textSize="@dimen/text_size_12"
        app:layout_constraintTop_toBottomOf="@+id/txtNotificationTitle"
        app:layout_constraintStart_toStartOf="parent"/>


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/deleteNotification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:tint="?attr/colorPrimary"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@+id/txtNotificationDescription"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_delete_24" />

</androidx.constraintlayout.widget.ConstraintLayout>